from collections.abc import Iterable, Iterator
import os
import sys
from typing import Any, Literal, TypeVar, overload

if sys.version_info >= (3, 12):
    from collections.abc import Buffer
else:
    from typing_extensions import Buffer

__version__: str

PathLike = str | os.PathLike[str]
SeqLike = str | bytes | bytearray | memoryview | Buffer
_T = TypeVar("_T")

class InputStats:
    @property
    def records(self) -> int: ...
    @property
    def bases(self) -> int: ...
    def __repr__(self) -> str: ...
    def __eq__(self, other: object) -> bool: ...
    def __hash__(self) -> int: ...

class DatabaseHeader:
    @property
    def k(self) -> int: ...
    @property
    def canonical(self) -> bool: ...
    @property
    def entries(self) -> int: ...
    @property
    def order(self) -> Literal["unordered", "hash", "kmer"]: ...
    @property
    def ascending(self) -> bool: ...
    def __repr__(self) -> str: ...
    def __eq__(self, other: object) -> bool: ...
    def __hash__(self) -> int: ...

class DatabaseReader:
    def __init__(self, path: PathLike) -> None: ...
    @property
    def header(self) -> DatabaseHeader: ...
    @property
    def k(self) -> int: ...
    @property
    def canonical(self) -> bool: ...
    @property
    def entries(self) -> int: ...
    def write_tsv(self, path: PathLike) -> None: ...
    def close(self) -> None: ...
    def __iter__(self) -> DatabaseReader: ...
    def __next__(self) -> tuple[str, int]: ...
    def __enter__(self) -> DatabaseReader: ...
    def __exit__(
        self,
        exc_type: type[BaseException] | None,
        exc_val: BaseException | None,
        exc_tb: Any,
    ) -> bool: ...
    def __repr__(self) -> str: ...

class Counter:
    def __init__(
        self,
        k: int,
        *,
        canonical: bool = True,
        capacity: int = 0,
    ) -> None: ...
    @property
    def k(self) -> int: ...
    @property
    def canonical(self) -> bool: ...
    def __len__(self) -> int: ...
    def __bool__(self) -> bool: ...
    def __contains__(self, kmer: SeqLike) -> bool: ...
    def __getitem__(self, kmer: SeqLike) -> int: ...
    def __iter__(self) -> Iterator[str]: ...
    def __repr__(self) -> str: ...
    def add_record(self, sequence: SeqLike) -> None: ...
    def add_records(self, records: Iterable[SeqLike]) -> None: ...
    def add_file(self, path: PathLike) -> InputStats: ...
    def add_files(self, paths: PathLike | Iterable[PathLike]) -> InputStats: ...
    def merge(self, other: Counter) -> None: ...
    @overload
    def get(self, kmer: SeqLike) -> int: ...
    @overload
    def get(self, kmer: SeqLike, default: _T) -> int | _T: ...
    def get_many(self, kmers: Iterable[SeqLike]) -> list[int]: ...
    def get_packed(self, key: int) -> int: ...
    def get_packed_many(self, keys: Buffer | Iterable[int]) -> list[int]: ...
    def get_packed_many_buffer(self, keys: Buffer | Iterable[int]) -> bytearray: ...
    def histogram(self) -> list[tuple[int, int]]: ...
    def top_k(self, n: int) -> list[tuple[str, int]]: ...
    def count_filtered(
        self,
        *,
        min_count: int = 1,
        max_count: int | None = None,
    ) -> int: ...
    def items(
        self,
        *,
        min_count: int = 1,
        max_count: int | None = None,
    ) -> list[tuple[str, int]]: ...
    def keys(
        self,
        *,
        min_count: int = 1,
        max_count: int | None = None,
    ) -> list[str]: ...
    def values(
        self,
        *,
        min_count: int = 1,
        max_count: int | None = None,
    ) -> list[int]: ...
    def to_dict(
        self,
        *,
        min_count: int = 1,
        max_count: int | None = None,
    ) -> dict[str, int]: ...
    def to_packed_buffers(
        self,
        *,
        min_count: int = 1,
        max_count: int | None = None,
    ) -> tuple[bytearray, bytearray]: ...
    def to_ascii_buffers(
        self,
        *,
        min_count: int = 1,
        max_count: int | None = None,
    ) -> tuple[bytearray, bytearray]: ...
    def to_numpy(
        self,
        *,
        min_count: int = 1,
        max_count: int | None = None,
        packed: bool = False,
    ) -> tuple[Any, Any]: ...
    def write_tsv(
        self,
        path: PathLike,
        *,
        min_count: int = 1,
        max_count: int | None = None,
    ) -> None: ...
    def write_binary(
        self,
        path: PathLike,
        *,
        min_count: int = 1,
        max_count: int | None = None,
    ) -> None: ...
    @staticmethod
    def read_binary(path: PathLike) -> Counter: ...

def count_files(
    paths: PathLike | Iterable[PathLike],
    k: int,
    *,
    canonical: bool = True,
    threads: int = 1,
    readers: int = 2,
    capacity: int = 0,
) -> Counter: ...

def count_files_to_disk(
    paths: PathLike | Iterable[PathLike],
    output: PathLike,
    k: int,
    *,
    memory: int | str,
    canonical: bool = True,
    threads: int = 1,
    readers: int = 2,
    temp_dir: PathLike | None = None,
    format: Literal["binary", "tsv"] = "binary",
    sorted: bool = False,
) -> int: ...

def count_records(
    records: Iterable[SeqLike],
    k: int,
    *,
    canonical: bool = True,
    threads: int = 1,
    capacity: int = 0,
) -> Counter: ...

def read_binary(path: PathLike) -> Counter: ...
def open_database(path: PathLike) -> DatabaseReader: ...
